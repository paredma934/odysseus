# Mission Control talks to Odysseus through the local Vite proxy by default.
VITE_ODYSSEUS_API_BASE=/odysseus-api
VITE_OLLAMA_API_BASE=/ollama-api
VITE_ODYSSEUS_SESSION_ID=7072e066-e3d5-41b4-8104-10eb3df078e0
VITE_ODYSSEUS_MODEL=llama3.2:3b

# Optional private, on-device "Jarvis" wake-word detection.
# Create the key in Picovoice Console and keep it in .env.local, never Git.
VITE_PICOVOICE_ACCESS_KEY=
VITE_JARVIS_WAKEWORD_MODEL_PATH=/wakewords/jarvis.ppn
VITE_PORCUPINE_MODEL_PATH=/wakewords/porcupine_params.pv
VITE_ODYSSEUS_API_URL=http://localhost:7860
VITE_ODYSSEUS_WS_URL=ws://localhost:7860

# Optional shell environment override for the Vite proxy target:
# ODYSSEUS_TARGET=http://127.0.0.1:7860
# OLLAMA_TARGET=http://127.0.0.1:11434
